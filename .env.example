# Leave VITE_API_BASE_URL empty to use the built-in prototype data service.
VITE_API_BASE_URL=http://localhost:8000

# Optional. When omitted, the WebSocket URL is derived from VITE_API_BASE_URL.
VITE_WS_URL=ws://localhost:8000/ws/alerts

# Backend prototype auth and mock integrations
JWT_SECRET=replace-with-a-long-local-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_DEV_FALLBACK=true
DEMO_ADMIN_PASSWORD=admin123
DEMO_STATE_PASSWORD=state123
DEMO_BANK_PASSWORD=bank123
WEBHOOK_SECRET=mock-bank-secret
